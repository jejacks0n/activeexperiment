# frozen_string_literal: true

# The tables ActiveExperiment::Recorders::ActiveRecordRecorder writes to, which
# are only needed if that's the recorder in use:
#
#   config.active_experiment.default_recorder = :active_record
#
# What they hold is bounded. One row per experiment, a row per variant per day,
# and a row per pair of experiments seen together, so they stay relatively small
# whatever the traffic is.
class CreateActiveExperimentRecorderTables < ActiveRecord::Migration[<%= ActiveRecord::Migration.current_version %>]
  def change
    # One row per experiment that's been seen.
    create_table :active_experiment_experiments do |t|
      t.string :name, null: false, limit: 191
      t.string :class_name
      t.string :state, null: false, default: "running"
      t.text :variant_names
      t.string :default_variant
      t.text :rollout
      t.string :cache_store
      t.datetime :first_seen_at
      t.datetime :last_seen_at
      t.datetime :concluded_at
      t.string :winning_variant
      t.text :notes
    end

    add_index :active_experiment_experiments, :name,
      unique: true, name: "index_ae_experiments_on_name"

    # Daily counts per variant.
    #
    # The from_* counters break down how the variant came to be assigned, and
    # sum to runs.
    create_table :active_experiment_rollups do |t|
      t.string :experiment, null: false, limit: 191
      t.string :variant, null: false, limit: 64
      t.date :date, null: false

      t.integer :runs, null: false, default: 0
      t.integer :skipped, null: false, default: 0
      t.integer :errored, null: false, default: 0

      t.integer :from_preset, null: false, default: 0
      t.integer :from_skipped, null: false, default: 0
      t.integer :from_cached, null: false, default: 0
      t.integer :from_segment, null: false, default: 0
      t.integer :from_rollout, null: false, default: 0
      t.integer :from_default, null: false, default: 0
      t.integer :from_concluded, null: false, default: 0
    end

    add_index :active_experiment_rollups, [:experiment, :variant, :date],
      unique: true, name: "index_ae_rollups_uniqueness"

    # How two experiments that ran together are related, per pair of variants.
    #
    # At depth 0 they simply ran together, and the pair is stored in a
    # canonical order so it's one row rather than two. Above that one ran
    # inside the other, the order is the order it happened in, and the depth is
    # how far apart they were.
    create_table :active_experiment_overlaps do |t|
      t.string :experiment_a, null: false, limit: 191
      t.string :variant_a, null: false, limit: 64
      t.string :experiment_b, null: false, limit: 191
      t.string :variant_b, null: false, limit: 64
      t.integer :depth, null: false, default: 0
      t.integer :count, null: false, default: 0
      t.datetime :last_seen_at
    end

    add_index :active_experiment_overlaps,
      [:experiment_a, :variant_a, :experiment_b, :variant_b, :depth],
      unique: true, name: "index_ae_overlaps_uniqueness"
  end
end
